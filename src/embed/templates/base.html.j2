{# Shared chrome for every wrapper response.

   - meta viewport so the embed sizes to the
     parent iframe on mobile
   - color-scheme: light dark so providers that
     respect prefers-color-scheme pick the right
     tone (YouTube, Bluesky)
   - referrer no-referrer protects user privacy:
     the provider sees us as the referrer, not
     the consumer site
   - a small reset so the inner iframe / preview
     card fills the available space without
     padding from the browser default
#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport"
      content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="referrer" content="no-referrer">
<title>{{ title }}</title>
<style>
  html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    background: transparent;
    font-family: system-ui, -apple-system, sans-serif;
  }
  iframe {
    border: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  {% block extra_style %}{% endblock %}
</style>
</head>
<body>
{% block body %}{% endblock %}
</body>
</html>
